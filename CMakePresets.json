{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ini_manager_DEVELOPER_MODE": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "INI_MANAGER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "dev-linux-gcc",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "dev-linux-clang",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "dev-darwin",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "dev-win64",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ci-ubuntu",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-clang",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-macos",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-windows",
      "inherits": "dev-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-sanitize",
      "inherits": "ci-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INI_MANAGER_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ci-coverage",
      "inherits": "ci-ubuntu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON",
        "COVERAGE_HTML_COMMAND": ""
      }
    },
    {
      "name": "fuzz",
      "inherits": "dev-linux-clang",
      "cacheVariables": {
        "INI_MANAGER_BUILD_FUZZER": "ON",
        "BUILD_TESTING": "OFF",
        "BUILD_EXAMPLES": "OFF",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ini_manager_DEVELOPER_MODE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-linux-gcc",
      "configurePreset": "dev-linux-gcc"
    },
    {
      "name": "dev-linux-clang",
      "configurePreset": "dev-linux-clang"
    },
    {
      "name": "dev-darwin",
      "configurePreset": "dev-darwin"
    },
    {
      "name": "dev-win64",
      "configurePreset": "dev-win64"
    },
    {
      "name": "ci-ubuntu",
      "configurePreset": "ci-ubuntu"
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang"
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize"
    },
    {
      "name": "ci-coverage",
      "configurePreset": "ci-coverage"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "dev-clang-quality",
      "configurePreset": "dev-linux-clang",
      "targets": [
        "tidy-check",
        "format-check",
        "spell-check",
        "all_verify_interface_header_sets",
        "run-examples"
      ]
    },
    {
      "name": "dev-gcc-examples",
      "configurePreset": "dev-linux-gcc",
      "targets": [
        "run-examples",
        "all_verify_interface_header_sets"
      ]
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-linux-gcc",
      "configurePreset": "dev-linux-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-linux-clang",
      "configurePreset": "dev-linux-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-darwin",
      "configurePreset": "dev-darwin",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-win64",
      "configurePreset": "dev-win64",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-ubuntu",
      "configurePreset": "ci-ubuntu",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-coverage",
      "configurePreset": "ci-coverage",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "$schema": "https://cmake.org/cmake/help/v4.0/manual/presets/schema.json",
  "$comment": "ini_manager 1.0.0: shared build, verification and packaging workflows.",
  "packagePresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "generators": [
        "TGZ",
        "ZIP"
      ],
      "packageDirectory": "${sourceDir}/build/release/packages"
    }
  ],
  "workflowPresets": [
    {
      "name": "verify-gcc",
      "displayName": "GCC build, tests, examples and standalone header verification",
      "steps": [
        {
          "type": "configure",
          "name": "dev-linux-gcc"
        },
        {
          "type": "build",
          "name": "dev-linux-gcc"
        },
        {
          "type": "test",
          "name": "dev-linux-gcc"
        },
        {
          "type": "build",
          "name": "dev-gcc-examples"
        }
      ]
    },
    {
      "name": "verify-clang",
      "displayName": "Clang build, tests and strict quality checks",
      "steps": [
        {
          "type": "configure",
          "name": "dev-linux-clang"
        },
        {
          "type": "build",
          "name": "dev-linux-clang"
        },
        {
          "type": "test",
          "name": "dev-linux-clang"
        },
        {
          "type": "build",
          "name": "dev-clang-quality"
        }
      ]
    },
    {
      "name": "package-release",
      "displayName": "Build distributable header-only archives",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "package",
          "name": "release"
        }
      ]
    }
  ]
}
